chan input_chan {
    right beat : (logic[34]@#1)
}

chan output_chan {
    right beat : (logic[34]@#1)
}


proc test_buffer(
    inp : right input_chan,
    out : left output_chan
) {
    reg stored : logic[34];

    loop {
        try b = recv inp.beat {

            set stored := b;

            cycle 1

        } else {

            cycle 1
        }
    }
}


proc router() {

    chan in_le -- in_ri : input_chan;
    chan out_le -- out_ri : output_chan;

    spawn test_buffer(
        in_ri,
        out_le
    );

    loop {
        cycle 1
    }
}

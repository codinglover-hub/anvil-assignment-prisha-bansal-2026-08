chan input_chan {
    right beat : (logic[34]@#1)
}

chan output_chan {
    right beat : (logic[34]@#1)
}

proc router_core(
    in0 : right input_chan,
    in1 : right input_chan,
    out0 : left output_chan,
    out1 : left output_chan
) {
    reg packet0 : logic[34];
    reg packet1 : logic[34];

    reg valid0 : logic;
    reg valid1 : logic;

    reg rr0 : logic;
    reg rr1 : logic;

    reg lock0 : logic;
    reg lock1 : logic;

    reg owner0 : logic;
    reg owner1 : logic;

    loop {

        try b0 = recv in0.beat {
            set packet0 := b0;
            set valid0 := 1'b1;
            cycle 1
        } else {
            cycle 1
        } >>

        try b1 = recv in1.beat {
            set packet1 := b1;
            set valid1 := 1'b1;
            cycle 1
        } else {
            cycle 1
        } >>

        if *valid0 == 1'b1 {
            if *packet0[1] == 1'b0 {
                send out0.beat(*packet0) >>
                set valid0 := 1'b0;
                cycle 1
            } else {
                send out1.beat(*packet0) >>
                set valid0 := 1'b0;
                cycle 1
            }
        } else {
            cycle 1
        } >>

        if *valid1 == 1'b1 {
            if *packet1[1] == 1'b0 {
                send out0.beat(*packet1) >>
                set valid1 := 1'b0;
                cycle 1
            } else {
                send out1.beat(*packet1) >>
                set valid1 := 1'b0;
                cycle 1
            }
        } else {
            cycle 1
        } >>

        cycle 1
    }
}

proc router_equiv(
    in0 : right input_chan,
    in1 : right input_chan,
    out0 : left output_chan,
    out1 : left output_chan
) {
    spawn router_core(
        in0,
        in1,
        out0,
        out1
    );

    loop {
        cycle 1
    }
}

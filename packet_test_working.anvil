
chan input_chan {
    right beat : (logic[34]@#1)
}

chan output_chan {
    right beat : (logic[34]@#1)
}


/*
 * One-input / one-output registered datapath.
 *
 * The important pattern is:
 *
 *     recv -> register -> send register
 *
 * rather than:
 *
 *     recv -> send received value
 *
 * This is the pattern we need for the larger router because
 * Anvil's lifetime checker rejected direct forwarding in our
 * earlier experiments.
 */

proc packet_router(
    inp : right input_chan,
    out : left output_chan
) {
    reg packet : logic[34];
    reg valid  : logic;

    loop {

        /*
         * Receive and store.
         */
        try b = recv inp.beat {

            set packet := b;
            set valid := 1'b1;

            cycle 1

        } else {

            cycle 1
        } >>

        /*
         * Send the stored packet.
         */
        if (*valid == 1'b1) {

            send out.beat(*packet) >>

            set valid := 1'b0;

            cycle 1

        } else {

            cycle 1
        }
    }
}


/*
 * Top level.
 */
proc router() {

    chan in_le -- in_ri : input_chan;
    chan out_le -- out_ri : output_chan;

    spawn packet_router(
        in_ri,
        out_le
    );

    loop {
        cycle 1
    }
}


`timescale 1ns/1ps

// ================================================================
// 2-input, 2-output ready/valid packet router
//
// Features:
//   - Two input ports: S0, S1
//   - Two output ports: M0, M1
//   - 1-bit destination (tdest)
//   - Ready/valid handshake
//   - Multi-beat packets terminated by tlast
//   - Packet locking to prevent interleaving
//   - Per-output round-robin arbitration
// ================================================================

module router #(
    parameter DATA_WIDTH = 8
)(
    input  logic clk,
    input  logic rst,

    // INPUT 0

    input  logic [DATA_WIDTH-1:0] s0_tdata,
    input  logic                  s0_tvalid,
    output logic                  s0_tready,
    input  logic                  s0_tlast,
    input  logic                  s0_tdest,

    // INPUT 1
    
    input  logic [DATA_WIDTH-1:0] s1_tdata,
    input  logic                  s1_tvalid,
    output logic                  s1_tready,
    input  logic                  s1_tlast,
    input  logic                  s1_tdest,

    // ============================================================
    // OUTPUT 0
    // ============================================================

    output logic [DATA_WIDTH-1:0] m0_tdata,
    output logic                  m0_tvalid,
    input  logic                  m0_tready,
    output logic                  m0_tlast,

    // ============================================================
    // OUTPUT 1
    // ============================================================

    output logic [DATA_WIDTH-1:0] m1_tdata,
    output logic                  m1_tvalid,
    input  logic                  m1_tready,
    output logic                  m1_tlast
);

    // Packet lock state
   

   logic lock0;
    logic lock1;

    logic owner0;
    logic owner1;

    // ============================================================
    // Round-robin priority
    // ============================================================

    logic rr0;
    logic rr1;

    // ============================================================
    // Selected input
    // ============================================================

    logic       sel0;
    logic       sel1;

    logic       grant0;
    logic       grant1;

    // ============================================================
    // HANDSHAKE SIGNALS
    // ============================================================

    logic fire0;
    logic fire1;

    assign fire0 = m0_tvalid && m0_tready;
    assign fire1 = m1_tvalid && m1_tready;


    // ============================================================
    // ARBITRATION FOR OUTPUT 0
    // ============================================================

    always_comb begin

        grant0 = 1'b0;
        sel0   = 1'b0;

        // --------------------------------------------------------
        // If M0 is already locked, continue using the same input.
        // --------------------------------------------------------

        if (lock0) begin

            grant0 = 1'b1;
            sel0   = owner0;

        end

        // --------------------------------------------------------
        // Otherwise perform arbitration.
        // --------------------------------------------------------

        else begin

            // Both inputs request M0
            if ((s0_tvalid && (s0_tdest == 1'b0)) &&
                (s1_tvalid && (s1_tdest == 1'b0))) begin

                grant0 = 1'b1;

                if (rr0 == 1'b0)
                    sel0 = 1'b0;       // choose S0
                else
                    sel0 = 1'b1;       // choose S1
            end

            // Only S0 requests M0
            else if (s0_tvalid && (s0_tdest == 1'b0)) begin

                grant0 = 1'b1;
                sel0   = 1'b0;

            end

            // Only S1 requests M0
            else if (s1_tvalid && (s1_tdest == 1'b0)) begin

                grant0 = 1'b1;
                sel0   = 1'b1;

            end

        end
    end


    // ============================================================
    // ARBITRATION FOR OUTPUT 1
    // ============================================================

    always_comb begin

        grant1 = 1'b0;
        sel1   = 1'b0;

        // --------------------------------------------------------
        // If M1 is already locked, continue using the same input.
        // --------------------------------------------------------

        if (lock1) begin

            grant1 = 1'b1;
            sel1   = owner1;

        end

        // --------------------------------------------------------
        // Otherwise perform arbitration.
        // --------------------------------------------------------

        else begin

            // Both inputs request M1
            if ((s0_tvalid && (s0_tdest == 1'b1)) &&
                (s1_tvalid && (s1_tdest == 1'b1))) begin

                grant1 = 1'b1;

                if (rr1 == 1'b0)
                    sel1 = 1'b0;       // choose S0
                else
                    sel1 = 1'b1;       // choose S1
            end

            // Only S0 requests M1
            else if (s0_tvalid && (s0_tdest == 1'b1)) begin

                grant1 = 1'b1;
                sel1   = 1'b0;

            end

            // Only S1 requests M1
            else if (s1_tvalid && (s1_tdest == 1'b1)) begin

                grant1 = 1'b1;
                sel1   = 1'b1;

            end

        end
    end


    // ============================================================
    // OUTPUT DATA
    // ============================================================

    always_comb begin

        // Default values
        m0_tdata  = '0;
        m0_tvalid = 1'b0;
        m0_tlast  = 1'b0;

        m1_tdata  = '0;
        m1_tvalid = 1'b0;
        m1_tlast  = 1'b0;


        // --------------------------------------------------------
        // OUTPUT M0
        // --------------------------------------------------------

        if (grant0) begin

            if (sel0 == 1'b0) begin

                // S0 -> M0
                m0_tdata  = s0_tdata;
                m0_tvalid = s0_tvalid;
                m0_tlast  = s0_tlast;

            end
            else begin

                // S1 -> M0
                m0_tdata  = s1_tdata;
                m0_tvalid = s1_tvalid;
                m0_tlast  = s1_tlast;

            end

        end


        // --------------------------------------------------------
        // OUTPUT M1
        // --------------------------------------------------------

        if (grant1) begin

            if (sel1 == 1'b0) begin

                // S0 -> M1
                m1_tdata  = s0_tdata;
                m1_tvalid = s0_tvalid;
                m1_tlast  = s0_tlast;

            end
            else begin

                // S1 -> M1
                m1_tdata  = s1_tdata;
                m1_tvalid = s1_tvalid;
                m1_tlast  = s1_tlast;

            end

        end

    end


    // ============================================================
    // READY SIGNALS
    //
    // An input is ready when:
    //
    //   1. It is selected
    //   2. The corresponding output is ready
    //
    // ============================================================

    always_comb begin

        s0_tready = 1'b0;
        s1_tready = 1'b0;


        // --------------------------------------------------------
        // S0 selected for M0
        // --------------------------------------------------------

        if (grant0 && (sel0 == 1'b0))
            s0_tready = m0_tready;


        // --------------------------------------------------------
        // S1 selected for M0
        // --------------------------------------------------------

        if (grant0 && (sel0 == 1'b1))
            s1_tready = m0_tready;


        // --------------------------------------------------------
        // S0 selected for M1
        // --------------------------------------------------------

        if (grant1 && (sel1 == 1'b0))
            s0_tready = s0_tready | m1_tready;


        // --------------------------------------------------------
        // S1 selected for M1
        // --------------------------------------------------------

        if (grant1 && (sel1 == 1'b1))
            s1_tready = s1_tready | m1_tready;

    end


    // ============================================================
    // SEQUENTIAL STATE
    //
    // This block remembers:
    //   - packet locks
    //   - packet owners
    //   - round-robin priority
    // ============================================================

    always_ff @(posedge clk) begin

        if (rst) begin

            lock0  <= 1'b0;
            lock1  <= 1'b0;

            owner0 <= 1'b0;
            owner1 <= 1'b0;

            rr0    <= 1'b0;
            rr1    <= 1'b0;

        end

        else begin

            // ====================================================
            // M0 PACKET LOCK
            // ====================================================

            // If M0 is not locked and a transfer starts
            if (!lock0 && fire0) begin

                if (s0_tlast == 1'b0) begin

                    // S0 owns M0 for the rest of the packet
                    lock0  <= 1'b1;
                    owner0 <= 1'b0;

                end
                else begin

                    // Single-beat packet
                    lock0 <= 1'b0;

                end

            end

            // If M0 is already locked
            else if (lock0 && fire0) begin

                // Last beat finishes the packet
                if (m0_tlast) begin
                    lock0 <= 1'b0;
                end

            end


            // ====================================================
            // M1 PACKET LOCK
            // ====================================================

            if (!lock1 && fire1) begin

                if (s0_tlast == 1'b0 && sel1 == 1'b0) begin

                    // S0 owns M1
                    lock1  <= 1'b1;
                    owner1 <= 1'b0;

                end

                else if (s1_tlast == 1'b0 && sel1 == 1'b1) begin

                    // S1 owns M1
                    lock1  <= 1'b1;
                    owner1 <= 1'b1;

                end

                else begin

                    // Single-beat packet
                    lock1 <= 1'b0;

                end

            end

            else if (lock1 && fire1) begin

                if (m1_tlast) begin
                    lock1 <= 1'b0;
                end

            end


            // ====================================================
            // ROUND-ROBIN UPDATE FOR M0
            // ====================================================

            if (fire0) begin

                if (sel0 == 1'b0)
                    rr0 <= 1'b1;       // next preference = S1
                else
                    rr0 <= 1'b0;       // next preference = S0

            end


            // ====================================================
            // ROUND-ROBIN UPDATE FOR M1
            // ====================================================

            if (fire1) begin

                if (sel1 == 1'b0)
                    rr1 <= 1'b1;       // next preference = S1
                else
                    rr1 <= 1'b0;       // next preference = S0

            end

        end

    end

endmodule


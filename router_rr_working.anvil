proc rr_test() {
    reg rr0 : logic;
    reg req0 : logic;
    reg req1 : logic;
    reg winner : logic;

    loop {
        let next_winner = if ((*req0 == 1'b1) && (*req1 == 1'b1)) {
            *rr0
        } else {
            if (*req0 == 1'b1) {
                1'b0
            } else {
                if (*req1 == 1'b1) {
                    1'b1
                } else {
                    1'b0
                }
            }
        } >>

        set winner := next_winner >>

        let next_rr = if ((*req0 == 1'b1) && (*req1 == 1'b1)) {
            if (*rr0 == 1'b0) {
                1'b1
            } else {
                1'b0
            }
        } else {
            *rr0
        } >>

        set rr0 := next_rr >>

        cycle 1
    }
}

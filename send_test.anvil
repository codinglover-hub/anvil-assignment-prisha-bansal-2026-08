chan input_chan {
    right beat : (logic[34]@#1)
}

chan output_chan {
    right beat : (logic[34]@#1)
}

proc receiver(inp : right input_chan, out : left output_chan)
{
    reg stored : logic[34];

    loop {
        try b = recv inp.beat {
            set stored := b >>
            cycle 1 >>
            let x = *stored >>
            send out.beat(x) >>
            cycle 1
        } else {
            cycle 1
        }
    }
}

proc sender(out : left input_chan)
{
    loop {
        let x : logic[34] = 34'd123 >>
        send out.beat(x) >>
        cycle 1
    }
}

proc monitor(inp : right output_chan)
{
    loop {
        let x = recv inp.beat >>
        dprint "RECEIVED = %h" (x) >>
        cycle 1
    }
}

proc send_test()
{
    chan in_le -- in_ri : input_chan;
    chan out_le -- out_ri : output_chan;

    spawn receiver(
        in_ri,
        out_le
    );

    spawn sender(
        in_le
    );

    spawn monitor(
        out_ri
    );

    loop {
        cycle 1
    }
}

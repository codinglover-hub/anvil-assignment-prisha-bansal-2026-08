chan input_chan {
    right beat : (logic[34]@#1)
}

chan output_chan {
    right beat : (logic[34]@#1)
}


/* ============================================================
 * INPUT 0 BUFFER
 * ============================================================ */

proc input0_buffer(
    inp : right input_chan
) {
    reg packet0 : logic[34];
    reg valid0 : logic;
    reg dest0 : logic;
    reg last0 : logic;

    loop {
        try b0 = recv inp.beat {
            set packet0 := b0;
            set valid0 := 1'b1;
            set dest0 := b0[1];
            set last0 := b0[0];
            cycle 1
        } else {
            cycle 1
        }
    }
}


/* ============================================================
 * INPUT 1 BUFFER
 * ============================================================ */

proc input1_buffer(
    inp : right input_chan
) {
    reg packet1 : logic[34];
    reg valid1 : logic;
    reg dest1 : logic;
    reg last1 : logic;

    loop {
        try b1 = recv inp.beat {
            set packet1 := b1;
            set valid1 := 1'b1;
            set dest1 := b1[1];
            set last1 := b1[0];
            cycle 1
        } else {
            cycle 1
        }
    }
}


/* ============================================================
 * OUTPUT 0 ARBITER
 *
 * RR:
 *   rr0 = 0 -> input 0 first
 *   rr0 = 1 -> input 1 first
 *
 * LOCK:
 *   lock0 = 1 -> current owner keeps output 0
 * ============================================================ */

proc output0_control(
    out0 : left output_chan
) {
    reg rr0 : logic;
    reg lock0 : logic;
    reg owner0 : logic;
    reg winner0 : logic;

    reg req0 : logic;
    reg req1 : logic;

    reg last0 : logic;
    reg last1 : logic;

    loop {

        /*
         * Request information.
         *
         * This is the control representation of the two
         * possible requesters for output 0.
         */
        set req0 := 1'b0;
        set req1 := 1'b0;


        /*
         * Arbitration.
         *
         * If the output is locked, keep the owner.
         *
         * Otherwise use the round-robin pointer.
         */
        let next_winner = if *lock0 == 1'b1 {
            *owner0
        } else {
            if *rr0 == 1'b0 {
                1'b0
            } else {
                1'b1
            }
        } >>

        set winner0 := next_winner;


        /*
         * Lock handling.
         *
         * A non-TLAST packet keeps the output locked.
         * TLAST releases the lock.
         */
        let next_lock = if *lock0 == 1'b1 {
            if *owner0 == 1'b0 {
                if *last0 == 1'b1 {
                    1'b0
                } else {
                    1'b1
                }
            } else {
                if *last1 == 1'b1 {
                    1'b0
                } else {
                    1'b1
                }
            }
        } else {
            1'b0
        } >>

        set lock0 := next_lock;


        /*
         * Owner.
         */
        let next_owner = if *lock0 == 1'b1 {
            *owner0
        } else {
            *winner0
        } >>

        set owner0 := next_owner;


        /*
         * Round-robin update.
         *
         * Change priority only when both requesters contend.
         */
        let next_rr = if *req0 == 1'b1 {
            if *req1 == 1'b1 {
                if *winner0 == 1'b0 {
                    1'b1
                } else {
                    1'b0
                }
            } else {
                *rr0
            }
        } else {
            *rr0
        } >>

        set rr0 := next_rr;

        cycle 1
    }
}


/* ============================================================
 * OUTPUT 1 ARBITER
 * ============================================================ */

proc output1_control(
    out1 : left output_chan
) {
    reg rr1 : logic;
    reg lock1 : logic;
    reg owner1 : logic;
    reg winner1 : logic;


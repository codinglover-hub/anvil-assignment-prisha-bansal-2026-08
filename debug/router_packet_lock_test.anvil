chan input_chan {
    right beat : (logic[34]@#1)
}

chan output_chan {
    right beat : (logic[34]@#1)
}


/* ============================================================
 * OUTPUT 0 PACKET LOCK TEST
 *
 * Two inputs compete for Output 0.
 *
 * rr:
 *   0 -> Input 0 priority
 *   1 -> Input 1 priority
 *
 * lock:
 *   0 -> choose a new owner
 *   1 -> keep current owner
 *
 * owner:
 *   0 -> Input 0
 *   1 -> Input 1
 * ============================================================ */

proc output0(
    inp0 : right input_chan,
    inp1 : right input_chan,
    out0 : left output_chan
) {
    reg packet0 : logic[34];
    reg packet1 : logic[34];

    reg valid0 : logic;
    reg valid1 : logic;

    reg last0 : logic;
    reg last1 : logic;

    reg rr : logic;
    reg lock : logic;
    reg owner : logic;
    reg winner : logic;

    loop {

        /* ----------------------------------------------------
         * Receive Input 0
         * ---------------------------------------------------- */

        try b0 = recv inp0.beat {
            set packet0 := b0;
            set valid0 := 1'b1;
            set last0 := b0[0];
            cycle 1
        } else {
            cycle 1
        } >>

        /* ----------------------------------------------------
         * Receive Input 1
         * ---------------------------------------------------- */

        try b1 = recv inp1.beat {
            set packet1 := b1;
            set valid1 := 1'b1;
            set last1 := b1[0];
            cycle 1
        } else {
            cycle 1
        } >>

        /* ----------------------------------------------------
         * Choose winner
         *
         * Locked -> owner
         * Unlocked -> RR
         * ---------------------------------------------------- */

        let selected = if *lock == 1'b1 {
            *owner
        } else {
            if *rr == 1'b0 {
                1'b0
            } else {
                1'b1
            }
        } >>

        set winner := selected;


        /* ----------------------------------------------------
         * Update owner
         *
         * If currently locked, keep owner.
         * Otherwise winner becomes the owner.
         * ---------------------------------------------------- */

        let next_owner = if *lock == 1'b1 {
            *owner
        } else {
            *winner
        } >>

        set owner := next_owner;


        /* ----------------------------------------------------
         * Update lock from the selected packet's TLAST.
         *
         * winner = 0 -> use last0
         * winner = 1 -> use last1
         * ---------------------------------------------------- */

        let next_lock = if *winner == 1'b0 {
            if *last0 == 1'b1 {
                1'b0
            } else {
                1'b1
            }
        } else {
            if *last1 == 1'b1 {
                1'b0
            } else {
                1'b1
            }
        } >>

        set lock := next_lock;


        /* ----------------------------------------------------
         * RR
         *
         * Winner 0 -> next priority 1
         * Winner 1 -> next priority 0
         * ---------------------------------------------------- */

        let next_rr = if *winner == 1'b0 {
            1'b1
        } else {
            1'b0
        } >>

        set rr := next_rr;


        cycle 1
    }
}


/* ============================================================
 * TOP LEVEL
 * ============================================================ */

proc router() {

    chan in0_le -- in0_ri : input_chan;
    chan in1_le -- in1_ri : input_chan;

    chan out0_le -- out0_ri : output_chan;


    spawn output0(
        in0_ri,
        in1_ri,
        out0_le
    );


    loop {
        cycle 1
    }
}

chan input_chan {
    right beat : (logic[34]@#1)
}

chan output_chan {
    right beat : (logic[34]@#1)
}


/* ============================================================
 * OUTPUT 0
 *
 * Receives packets from both inputs.
 * Destination 0 packets are arbitrated here.
 *
 * rr = 0 -> input 0 wins contention
 * rr = 1 -> input 1 wins contention
 *
 * lock = 1 -> current packet owner continues
 * ============================================================ */

proc output0(
    in0 : right input_chan,
    in1 : right input_chan,
    out0 : left output_chan
) {
    reg packet0 : logic[34];
    reg packet1 : logic[34];

    reg valid0 : logic;
    reg valid1 : logic;

    reg dest0 : logic;
    reg dest1 : logic;

    reg last0 : logic;
    reg last1 : logic;

    reg rr : logic;
    reg lock : logic;
    reg owner : logic;
    reg winner : logic;

    loop {

        /* Receive input 0 beat */
        try b0 = recv in0.beat {
            set packet0 := b0;
            set valid0 := 1'b1;
            set dest0 := b0[1];
            set last0 := b0[0];
            cycle 1
        } else {
            cycle 1
        } >>

        /* Receive input 1 beat */
        try b1 = recv in1.beat {
            set packet1 := b1;
            set valid1 := 1'b1;
            set dest1 := b1[1];
            set last1 := b1[0];
            cycle 1
        } else {
            cycle 1
        } >>

        /*
         * Select winner.
         *
         * When locked, owner continues.
         * Otherwise use RR when both inputs request output 0.
         */
        let selected = if *lock == 1'b1 {
            *owner
        } else {
            if *valid0 == 1'b1 {
                if *valid1 == 1'b1 {
                    if *rr == 1'b0 {
                        1'b0
                    } else {
                        1'b1
                    }
                } else {
                    1'b0
                }
            } else {
                if *valid1 == 1'b1 {
                    1'b1
                } else {
                    1'b0
                }
            }
        } >>

        set winner := selected;

        /*
         * Forward selected packet.
         *
         * send is the synchronization point, so it naturally
         * provides backpressure.
         */
        if *winner == 1'b0 {
            if *valid0 == 1'b1 {
                if *dest0 == 1'b0 {
                    send out0.beat(*packet0) >>
                    set valid0 := 1'b0;
                    cycle 1
                } else {
                    cycle 1
                }
            } else {
                cycle 1
            }
        } else {
            if *valid1 == 1'b1 {
                if *dest1 == 1'b0 {
                    send out0.beat(*packet1) >>
                    set valid1 := 1'b0;
                    cycle 1
                } else {
                    cycle 1
                }
            } else {
                cycle 1
            }
        } >>

        /*
         * Packet lock.
         *
         * If the transmitted beat is not TLAST, keep the
         * output locked to the same input.
         */
        let next_lock = if *winner == 1'b0 {
            if *valid0 == 1'b1 {
                if *dest0 == 1'b0 {
                    if *last0 == 1'b1 {
                        1'b0
                    } else {
                        1'b1
                    }
                } else {
                    *lock
                }
            } else {
                *lock
            }
        } else {
            if *valid1 == 1'b1 {
                if *dest1 == 1'b0 {
                    if *last1 == 1'b1 {
                        1'b0
                    } else {
                        1'b1
                    }
                } else {
                    *lock
                }
            } else {
                *lock
            }
        } >>

        set lock := next_lock;

        /*
         * Remember owner.
         */
        let next_owner = if *winner == 1'b0 {
            1'b0
        } else {
            1'b1
        } >>

        set owner := next_owner;

        /*
         * Update RR only when a contended packet completes.
         */
        let next_rr = if *valid0 == 1'b1 {
            if *valid1 == 1'b1 {
                if *winner == 1'b0 {
                    if *last0 == 1'b1 {
                        1'b1
                    } else {
                        *rr
                    }
                } else {
                    if *last1 == 1'b1 {
                        1'b0
                    } else {
                        *rr
                    }
                }
            } else {
                *rr
            }
        } else {
            *rr
        } >>

        set rr := next_rr;

        cycle 1
    }
}


/* ============================================================
 * OUTPUT 1
 *
 * Same structure as output 0, but only forwards destination 1.
 * ============================================================ */

proc output1(
    in0 : right input_chan,
    in1 : right input_chan,
    out1 : left output_chan
) {
    reg packet0 : logic[34];
    reg packet1 : logic[34];

    reg valid0 : logic;
    reg valid1 : logic;

    reg dest0 : logic;
    reg dest1 : logic;

    reg last0 : logic;
    reg last1 : logic;

    reg rr : logic;
    reg lock : logic;
    reg owner : logic;
    reg winner : logic;

    loop {

        try b0 = recv in0.beat {
            set packet0 := b0;
            set valid0 := 1'b1;
            set dest0 := b0[1];
            set last0 := b0[0];
            cycle 1
        } else {
            cycle 1
        } >>

        try b1 = recv in1.beat {
            set packet1 := b1;
            set valid1 := 1'b1;
            set dest1 := b1[1];
            set last1 := b1[0];
            cycle 1
        } else {
            cycle 1
        } >>

        let selected = if *lock == 1'b1 {
            *owner
        } else {
            if *valid0 == 1'b1 {
                if *valid1 == 1'b1 {
                    if *rr == 1'b0 {
                        1'b0
                    } else {
                        1'b1
                    }
                } else {
                    1'b0
                }
            } else {
                if *valid1 == 1'b1 {
                    1'b1
                } else {
                    1'b0
                }
            }
        } >>

        set winner := selected;

        if *winner == 1'b0 {
            if *valid0 == 1'b1 {
                if *dest0 == 1'b1 {
                    send out1.beat(*packet0) >>
                    set valid0 := 1'b0;
                    cycle 1
                } else {
                    cycle 1
                }
            } else {
                cycle 1
            }
        } else {
            if *valid1 == 1'b1 {
                if *dest1 == 1'b1 {
                    send out1.beat(*packet1) >>
                    set valid1 := 1'b0;
                    cycle 1
                } else {
                    cycle 1
                }
            } else {
                cycle 1
            }
        } >>

        let next_lock = if *winner == 1'b0 {
            if *valid0 == 1'b1 {
                if *dest0 == 1'b1 {
                    if *last0 == 1'b1 {
                        1'b0
                    } else {
                        1'b1
                    }
                } else {
                    *lock
                }
            } else {
                *lock
            }
        } else {
            if *valid1 == 1'b1 {
                if *dest1 == 1'b1 {
                    if *last1 == 1'b1 {
                        1'b0
                    } else {
                        1'b1
                    }
                } else {
                    *lock
                }
            } else {
                *lock
            }
        } >>

        set lock := next_lock;

        let next_owner = if *winner == 1'b0 {
            1'b0
        } else {
            1'b1
        } >>

        set owner := next_owner;

        let next_rr = if *valid0 == 1'b1 {
            if *valid1 == 1'b1 {
                if *winner == 1'b0 {
                    if *last0 == 1'b1 {
                        1'b1
                    } else {
                        *rr
                    }
                } else {
                    if *last1 == 1'b1 {
                        1'b0
                    } else {
                        *rr
                    }
                }
            } else {
                *rr
            }
        } else {
            *rr
        } >>

        set rr := next_rr;

        cycle 1
    }
}


/* ============================================================
 * TOP LEVEL
 * ============================================================ */

proc router() {

    chan in0_le -- in0_ri : input_chan;
    chan in1_le -- in1_ri : input_chan;

    chan out0_le -- out0_ri : output_chan;
    chan out1_le -- out1_ri : output_chan;

    /*
     * Both output arbiters receive the two input streams.
     */
    spawn output0(
        in0_ri,
        in1_ri,
        out0_le
    );

    spawn output1(
        in0_ri,
        in1_ri,
        out1_le
    );

    loop {
        cycle 1
    }
}

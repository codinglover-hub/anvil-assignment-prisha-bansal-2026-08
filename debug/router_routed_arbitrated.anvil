chan input_chan {
    right beat : (logic[34]@#1)
}

chan request_chan {
    right beat : (logic[34]@#1)
}

chan output_chan {
    right beat : (logic[34]@#1)
}


/* ============================================================
 * INPUT 0 ROUTER
 *
 * Receives one input stream and routes every beat according
 * to destination:
 *
 *   dest = 0 -> output 0 request channel
 *   dest = 1 -> output 1 request channel
 *
 * The internal send also provides synchronization/backpressure.
 * ============================================================ */

proc input0_route(
    inp : right input_chan,
    to_out0 : left request_chan,
    to_out1 : left request_chan
) {
    reg packet : logic[34];
    reg dest : logic;
    reg valid : logic;

    loop {
        try b = recv inp.beat {
            set packet := b;
            set dest := b[1];
            set valid := 1'b1;
            cycle 1
        } else {
            cycle 1
        } >>

        if *valid == 1'b1 {
            if *dest == 1'b0 {
                send to_out0.beat(*packet) >>
                set valid := 1'b0;
                cycle 1
            } else {
                send to_out1.beat(*packet) >>
                set valid := 1'b0;
                cycle 1
            }
        } else {
            cycle 1
        }
    }
}


/* ============================================================
 * INPUT 1 ROUTER
 * ============================================================ */

proc input1_route(
    inp : right input_chan,
    to_out0 : left request_chan,
    to_out1 : left request_chan
) {
    reg packet : logic[34];
    reg dest : logic;
    reg valid : logic;

    loop {
        try b = recv inp.beat {
            set packet := b;
            set dest := b[1];
            set valid := 1'b1;
            cycle 1
        } else {
            cycle 1
        } >>

        if *valid == 1'b1 {
            if *dest == 1'b0 {
                send to_out0.beat(*packet) >>
                set valid := 1'b0;
                cycle 1
            } else {
                send to_out1.beat(*packet) >>
                set valid := 1'b0;
                cycle 1
            }
        } else {
            cycle 1
        }
    }
}


/* ============================================================
 * OUTPUT 0 ARBITER
 *
 * Receives destination-0 packets from both input routers.
 *
 * RR:
 *   rr = 0 -> input 0 priority
 *   rr = 1 -> input 1 priority
 *
 * LOCK:
 *   non-TLAST beat -> retain owner
 *   TLAST beat     -> release lock
 * ============================================================ */

proc output0_arbiter(
    from_in0 : right request_chan,
    from_in1 : right request_chan,
    out0 : left output_chan
) {
    reg packet0 : logic[34];
    reg packet1 : logic[34];

    reg valid0 : logic;
    reg valid1 : logic;

    reg last0 : logic;
    reg last1 : logic;

    reg rr : logic;
    reg lock : logic;
    reg owner : logic;
    reg winner : logic;

    loop {

        /* Receive pending request from input 0 */
        try b0 = recv from_in0.beat {
            set packet0 := b0;
            set valid0 := 1'b1;
            set last0 := b0[0];
            cycle 1
        } else {
            cycle 1
        } >>

        /* Receive pending request from input 1 */
        try b1 = recv from_in1.beat {
            set packet1 := b1;
            set valid1 := 1'b1;
            set last1 := b1[0];
            cycle 1
        } else {
            cycle 1
        } >>

        /*
         * Arbitration.
         */
        let selected = if *lock == 1'b1 {
            *owner
        } else {
            if *valid0 == 1'b1 {
                if *valid1 == 1'b1 {
                    if *rr == 1'b0 {
                        1'b0
                    } else {
                        1'b1
                    }
                } else {
                    1'b0
                }
            } else {
                if *valid1 == 1'b1 {
                    1'b1
                } else {
                    1'b0
                }
            }
        } >>

        set winner := selected;

        /*
         * Forward selected packet.
         */
        if *winner == 1'b0 {
            if *valid0 == 1'b1 {
                send out0.beat(*packet0) >>
                set valid0 := 1'b0;
                cycle 1
            } else {
                cycle 1
            }
        } else {
            if *valid1 == 1'b1 {
                send out0.beat(*packet1) >>
                set valid1 := 1'b0;
                cycle 1
            } else {
                cycle 1
            }
        } >>

        /*
         * Packet locking.
         */
        let next_lock = if *winner == 1'b0 {
            if *valid0 == 1'b1 {
                if *last0 == 1'b1 {
                    1'b0
                } else {
                    1'b1
                }
            } else {
                *lock
            }
        } else {
            if *valid1 == 1'b1 {
                if *last1 == 1'b1 {
                    1'b0
                } else {
                    1'b1
                }
            } else {
                *lock
            }
        } >>

        set lock := next_lock;

        /*
         * Owner.
         */
        let next_owner = if *winner == 1'b0 {
            1'b0
        } else {
            1'b1
        } >>

        set owner := next_owner;

        /*
         * RR changes only after a completed contended packet.
         */
        let next_rr = if *valid0 == 1'b1 {
            if *valid1 == 1'b1 {
                if *winner == 1'b0 {
                    if *last0 == 1'b1 {
                        1'b1
                    } else {
                        *rr
                    }
                } else {
                    if *last1 == 1'b1 {
                        1'b0
                    } else {
                        *rr
                    }
                }
            } else {
                *rr
            }
        } else {
            *rr
        } >>

        set rr := next_rr;

        cycle 1
    }
}


/* ============================================================
 * OUTPUT 1 ARBITER
 * ============================================================ */

proc output1_arbiter(
    from_in0 : right request_chan,
    from_in1 : right request_chan,
    out1 : left output_chan
) {
    reg packet0 : logic[34];
    reg packet1 : logic[34];

    reg valid0 : logic;
    reg valid1 : logic;

    reg last0 : logic;
    reg last1 : logic;

    reg rr : logic;
    reg lock : logic;
    reg owner : logic;
    reg winner : logic;

    loop {

        try b0 = recv from_in0.beat {
            set packet0 := b0;
            set valid0 := 1'b1;
            set last0 := b0[0];
            cycle 1
        } else {
            cycle 1
        } >>

        try b1 = recv from_in1.beat {
            set packet1 := b1;
            set valid1 := 1'b1;
            set last1 := b1[0];
            cycle 1
        } else {
            cycle 1
        } >>

        /*
         * Arbitration.
         */
        let selected = if *lock == 1'b1 {
            *owner
        } else {
            if *valid0 == 1'b1 {
                if *valid1 == 1'b1 {
                    if *rr == 1'b0 {
                        1'b0
                    } else {
                        1'b1
                    }
                } else {
                    1'b0
                }
            } else {
                if *valid1 == 1'b1 {
                    1'b1
                } else {
                    1'b0
                }
            }
        } >>

        set winner := selected;

        /*
         * Forward selected packet.
         */
        if *winner == 1'b0 {
            if *valid0 == 1'b1 {
                send out1.beat(*packet0) >>
                set valid0 := 1'b0;
                cycle 1
            } else {
                cycle 1
            }
        } else {
            if *valid1 == 1'b1 {
                send out1.beat(*packet1) >>
                set valid1 := 1'b0;
                cycle 1
            } else {
                cycle 1
            }
        } >>

        /*
         * Packet locking.
         */
        let next_lock = if *winner == 1'b0 {
            if *valid0 == 1'b1 {
                if *last0 == 1'b1 {
                    1'b0
                } else {
                    1'b1
                }
            } else {
                *lock
            }
        } else {
            if *valid1 == 1'b1 {
                if *last1 == 1'b1 {
                    1'b0
                } else {
                    1'b1
                }
            } else {
                *lock
            }
        } >>

        set lock := next_lock;

        /*
         * Owner.
         */
        let next_owner = if *winner == 1'b0 {
            1'b0
        } else {
            1'b1
        } >>

        set owner := next_owner;

        /*
         * RR update.
         */
        let next_rr = if *valid0 == 1'b1 {
            if *valid1 == 1'b1 {
                if *winner == 1'b0 {
                    if *last0 == 1'b1 {
                        1'b1
                    } else {
                        *rr
                    }
                } else {
                    if *last1 == 1'b1 {
                        1'b0
                    } else {
                        *rr
                    }
                }
            } else {
                *rr
            }
        } else {
            *rr
        } >>

        set rr := next_rr;

        cycle 1
    }
}


/* ============================================================
 * TOP LEVEL
 * ============================================================ */

proc router() {

    /*
     * External input channels.
     */
    chan in0_le -- in0_ri : input_chan;
    chan in1_le -- in1_ri : input_chan;

    /*
     * Internal request channels:
     *
     * input0 -> output0
     * input0 -> output1
     * input1 -> output0
     * input1 -> output1
     */
    chan i0_o0_le -- i0_o0_ri : request_chan;
    chan i0_o1_le -- i0_o1_ri : request_chan;

    chan i1_o0_le -- i1_o0_ri : request_chan;
    chan i1_o1_le -- i1_o1_ri : request_chan;

    /*
     * External output channels.
     */
    chan out0_le -- out0_ri : output_chan;
    chan out1_le -- out1_ri : output_chan;

    /*
     * Route input 0.
     */
    spawn input0_route(
        in0_ri,
        i0_o0_le,
        i0_o1_le
    );

    /*
     * Route input 1.
     */
    spawn input1_route(
        in1_ri,
        i1_o0_le,
        i1_o1_le
    );

    /*
     * Output 0 arbitration.
     */
    spawn output0_arbiter(
        i0_o0_ri,
        i1_o0_ri,
        out0_le
    );

    /*
     * Output 1 arbitration.
     */
    spawn output1_arbiter(
        i0_o1_ri,
        i1_o1_ri,
        out1_le
    );

    loop {
        cycle 1
    }
}

proc packet_lock_test() {

    reg lock0 : logic;
    reg owner0 : logic;

    reg winner : logic;
    reg last : logic;


    loop {

        /*
         * Example selected input.
         */
        set winner := 1'b0;

        /*
         * Example packet beat.
         *
         * Change this to 1'b1 to represent TLAST.
         */
        set last := 1'b0;


        /*
         * LOCK:
         *
         * If OUT0 is currently unlocked and the
         * selected beat is not TLAST, lock OUT0.
         */
        let next_lock =
            if ((*lock0 == 1'b0) && (*last == 1'b0)) {
                1'b1
            } else {
                if ((*lock0 == 1'b1) && (*last == 1'b1)) {
                    1'b0
                } else {
                    *lock0
                }
            } >>

        set lock0 := next_lock >>


        /*
         * OWNER:
         *
         * When a new packet starts, remember which
         * input owns OUT0.
         */
        let next_owner =
            if ((*lock0 == 1'b0) && (*last == 1'b0)) {
                *winner
            } else {
                *owner0
            } >>

        set owner0 := next_owner >>

        cycle 1
    }
}


proc router() {

    spawn packet_lock_test();

    loop {
        cycle 1
    }
}

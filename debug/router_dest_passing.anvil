chan input_chan {
    right beat : (logic[34]@#1)
}

chan output_chan {
    right beat : (logic[34]@#1)
}


/* ============================================================
 * INPUT 0 DESTINATION ROUTER
 *
 * dest = 0 -> output 0
 * dest = 1 -> output 1
 *
 * The packet is stored in registers first.
 * ============================================================ */

proc input0_route(
    inp : right input_chan
) {
    reg packet : logic[34];
    reg valid : logic;
    reg dest : logic;
    reg last : logic;

    loop {
        try b = recv inp.beat {
            set packet := b;
            set valid := 1'b1;
            set dest := b[1];
            set last := b[0];
            cycle 1
        } else {
            cycle 1
        }
    }
}


/* ============================================================
 * INPUT 1 DESTINATION ROUTER
 * ============================================================ */

proc input1_route(
    inp : right input_chan
) {
    reg packet : logic[34];
    reg valid : logic;
    reg dest : logic;
    reg last : logic;

    loop {
        try b = recv inp.beat {
            set packet := b;
            set valid := 1'b1;
            set dest := b[1];
            set last := b[0];
            cycle 1
        } else {
            cycle 1
        }
    }
}


/* ============================================================
 * OUTPUT 0
 *
 * This controller represents packets whose destination is 0.
 * ============================================================ */

proc output0_control(
    out0 : left output_chan
) {
    reg rr0 : logic;
    reg lock0 : logic;
    reg owner0 : logic;
    reg winner0 : logic;

    reg req0 : logic;
    reg req1 : logic;

    loop {
        set req0 := 1'b0;
        set req1 := 1'b0;

        let next_winner = if *rr0 == 1'b0 {
            1'b0
        } else {
            1'b1
        } >>

        set winner0 := next_winner;

        cycle 1
    }
}


/* ============================================================
 * OUTPUT 1
 *
 * This controller represents packets whose destination is 1.
 * ============================================================ */

proc output1_control(
    out1 : left output_chan
) {
    reg rr1 : logic;
    reg lock1 : logic;
    reg owner1 : logic;
    reg winner1 : logic;

    reg req0 : logic;
    reg req1 : logic;

    loop {
        set req0 := 1'b0;
        set req1 := 1'b0;

        let next_winner = if *rr1 == 1'b0 {
            1'b0
        } else {
            1'b1
        } >>

        set winner1 := next_winner;

        cycle 1
    }
}


/* ============================================================
 * TOP LEVEL
 * ============================================================ */

proc router() {

    chan in0_le -- in0_ri : input_chan;
    chan in1_le -- in1_ri : input_chan;

    chan out0_le -- out0_ri : output_chan;
    chan out1_le -- out1_ri : output_chan;


    spawn input0_route(
        in0_ri
    );

    spawn input1_route(
        in1_ri
    );

    spawn output0_control(
        out0_le
    );

    spawn output1_control(
        out1_le
    );


    loop {
        cycle 1
    }
}

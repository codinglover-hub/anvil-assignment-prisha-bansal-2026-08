
// ============================================================
// 2x2 CONCURRENT PACKET ROUTER - ANVIL
// ============================================================
//
// Packet format:
//
//   [33]    = TLAST
//   [32]    = TDEST
//   [31:0]  = TDATA
//
// TDEST:
//   0 -> Output 0
//   1 -> Output 1
//
// Architecture:
//
//   source0 ----> input0_router ----\
//                                     \
//                                      output0_arbiter ---> sink0
//                                     /
//   source1 ----> input1_router ----/
//
//   source0 ----> input0_router ----\
//                                     \
//                                      output1_arbiter ---> sink1
//                                     /
//   source1 ----> input1_router ----/
//
// Each output arbiter implements:
//   - 1-entry buffer per input
//   - packet locking
//   - owner tracking
//   - round-robin arbitration
//   - TLAST-based lock release
//
// ============================================================


// ============================================================
// STREAM CHANNEL
// ============================================================

chan stream_ch {
    left beat : (logic[34]@#1)
}


// ============================================================
// INTERNAL ROUTE CHANNEL
// ============================================================

chan route_ch {
    left beat : (logic[34]@#1)
}


// ============================================================
// INPUT 0 ROUTER
// ============================================================
//
// Receives beats from input 0.
// Examines TDEST.
// Sends each beat to output 0 or output 1.
//
// ============================================================

proc input0_router(
    in0     : left stream_ch,
    to_out0 : right route_ch,
    to_out1 : right route_ch
) {

    reg packet0 : logic[34];
    reg dest0   : logic;
    reg valid0  : logic;

    loop {

        if *valid0 == 1'b0 {

            try b = recv in0.beat {

                {
                    set packet0 := b;
                    set dest0 := b[32];
                    set valid0 := 1'b1
                } >>

                cycle 1

            } else {

                cycle 1
            }

        }

        else {

            if *dest0 == 1'b0 {

                send to_out0.beat(*packet0) >>
                set valid0 := 1'b0 >>
                cycle 1

            }

            else {

                send to_out1.beat(*packet0) >>
                set valid0 := 1'b0 >>
                cycle 1

            }
        }
    }
}


// ============================================================
// INPUT 1 ROUTER
// ============================================================

proc input1_router(
    in1     : left stream_ch,
    to_out0 : right route_ch,
    to_out1 : right route_ch
) {

    reg packet1 : logic[34];
    reg dest1   : logic;
    reg valid1  : logic;

    loop {

        if *valid1 == 1'b0 {

            try b = recv in1.beat {

                {
                    set packet1 := b;
                    set dest1 := b[32];
                    set valid1 := 1'b1
                } >>

                cycle 1

            } else {

                cycle 1
            }
        }

        else {

            if *dest1 == 1'b0 {

                send to_out0.beat(*packet1) >>
                set valid1 := 1'b0 >>
                cycle 1

            }

            else {

                send to_out1.beat(*packet1) >>
                set valid1 := 1'b0 >>
                cycle 1

            }
        }
    }
}


// ============================================================
// OUTPUT 0 ARBITER
// ============================================================
//
// Two input buffers:
//
//   packet0 / valid0
//   packet1 / valid1
//
// State:
//
//   rr0     = round-robin priority
//   lock0   = packet lock active
//   owner0  = input owning current packet
//
// If both inputs request output 0:
//   rr0 == 0 -> input 0 wins
//   rr0 == 1 -> input 1 wins
//
// If a packet continues (TLAST = 0):
//   lock remains active.
//
// If TLAST = 1:
//   lock is released.
//
// ============================================================

proc output0_arbiter(
    from_in0 : left route_ch,
    from_in1 : left route_ch,
    out0     : right stream_ch
) {

    reg packet0 : logic[34];
    reg packet1 : logic[34];

    reg valid0 : logic;
    reg valid1 : logic;

    reg rr0    : logic;
    reg lock0  : logic;
    reg owner0 : logic;

    loop {

        // ----------------------------------------------------
        // Fill input 0 buffer
        // ----------------------------------------------------

        (if *valid0 == 1'b0 {

            try b0 = recv from_in0.beat {

                {
                    set packet0 := b0;
                    set valid0 := 1'b1
                } >>

                cycle 1

            } else {

                cycle 1
            }

        } else {

            cycle 1

        }) >>

        // ----------------------------------------------------
        // Fill input 1 buffer
        // ----------------------------------------------------

        (if *valid1 == 1'b0 {

            try b1 = recv from_in1.beat {

                {
                    set packet1 := b1;
                    set valid1 := 1'b1
                } >>

                cycle 1

            } else {

                cycle 1
            }

        } else {

            cycle 1

        }) >>

        // ----------------------------------------------------
        // Arbitration
        // ----------------------------------------------------

        (if *lock0 == 1'b1 {

            // ------------------------------------------------
            // Packet lock is active
            // ------------------------------------------------

            if *owner0 == 1'b0 {

                if *valid0 == 1'b1 {

                    send out0.beat(*packet0) >>

                    if (*packet0)[33] == 1'b1 {

                        {
                            set valid0 := 1'b0;
                            set lock0 := 1'b0
                        }

                    } else {

                        set valid0 := 1'b0
                    }

                } else {

                    cycle 1
                }

            } else {

                if *valid1 == 1'b1 {

                    send out0.beat(*packet1) >>

                    if (*packet1)[33] == 1'b1 {

                        {
                            set valid1 := 1'b0;
                            set lock0 := 1'b0
                        }

                    } else {

                        set valid1 := 1'b0
                    }

                } else {

                    cycle 1
                }
            }

        }

        else {

            // ------------------------------------------------
            // No packet lock
            // ------------------------------------------------

            if ((*valid0 == 1'b1) & (*valid1 == 1'b1)) {

                // ------------------------------------------------
                // Contention: use round-robin
                // ------------------------------------------------

                if *rr0 == 1'b0 {

                    send out0.beat(*packet0) >>

                    {
                        set rr0 := 1'b1;
                        set valid0 := 1'b0
                    } >>

                    if (*packet0)[33] == 1'b0 {

                        {
                            set lock0 := 1'b1;
                            set owner0 := 1'b0
                        }

                    } else {

                        cycle 1
                    }

                } else {

                    send out0.beat(*packet1) >>

                    {
                        set rr0 := 1'b0;
                        set valid1 := 1'b0
                    } >>

                    if (*packet1)[33] == 1'b0 {

                        {
                            set lock0 := 1'b1;
                            set owner0 := 1'b1
                        }

                    } else {

                        cycle 1
                    }
                }
            }

            else if *valid0 == 1'b1 {

                // ------------------------------------------------
                // Only input 0 is requesting
                // ------------------------------------------------

                send out0.beat(*packet0) >>
                set valid0 := 1'b0 >>

                if (*packet0)[33] == 1'b0 {

                    {
                        set lock0 := 1'b1;
                        set owner0 := 1'b0
                    }

                } else {

                    cycle 1
                }
            }

            else if *valid1 == 1'b1 {

                // ------------------------------------------------
                // Only input 1 is requesting
                // ------------------------------------------------

                send out0.beat(*packet1) >>
                set valid1 := 1'b0 >>

                if (*packet1)[33] == 1'b0 {

                    {
                        set lock0 := 1'b1;
                        set owner0 := 1'b1
                    }

                } else {

                    cycle 1
                }
            }

            else {

                cycle 1
            }
        })
    }
}


// ============================================================
// OUTPUT 1 ARBITER
// ============================================================

proc output1_arbiter(
    from_in0 : left route_ch,
    from_in1 : left route_ch,
    out1     : right stream_ch
) {

    reg packet0 : logic[34];
    reg packet1 : logic[34];

    reg valid0 : logic;
    reg valid1 : logic;

    reg rr1    : logic;
    reg lock1  : logic;
    reg owner1 : logic;

    loop {

        // ----------------------------------------------------
        // Fill input 0 buffer
        // ----------------------------------------------------

        (if *valid0 == 1'b0 {

            try b0 = recv from_in0.beat {

                {
                    set packet0 := b0;
                    set valid0 := 1'b1
                } >>

                cycle 1

            } else {

                cycle 1
            }

        } else {

            cycle 1

        }) >>

        // ----------------------------------------------------
        // Fill input 1 buffer
        // ----------------------------------------------------

        (if *valid1 == 1'b0 {

            try b1 = recv from_in1.beat {

                {
                    set packet1 := b1;
                    set valid1 := 1'b1
                } >>

                cycle 1

            } else {

                cycle 1
            }

        } else {

            cycle 1

        }) >>

        // ----------------------------------------------------
        // Arbitration
        // ----------------------------------------------------

        (if *lock1 == 1'b1 {

            // ------------------------------------------------
            // Packet lock is active
            // ------------------------------------------------

            if *owner1 == 1'b0 {

                if *valid0 == 1'b1 {

                    send out1.beat(*packet0) >>

                    if (*packet0)[33] == 1'b1 {

                        {
                            set valid0 := 1'b0;
                            set lock1 := 1'b0
                        }

                    } else {

                        set valid0 := 1'b0
                    }

                } else {

                    cycle 1
                }

            } else {

                if *valid1 == 1'b1 {

                    send out1.beat(*packet1) >>

                    if (*packet1)[33] == 1'b1 {

                        {
                            set valid1 := 1'b0;
                            set lock1 := 1'b0
                        }

                    } else {

                        set valid1 := 1'b0
                    }

                } else {

                    cycle 1
                }
            }

        }

        else {

            // ------------------------------------------------
            // No packet lock
            // ------------------------------------------------

            if ((*valid0 == 1'b1) & (*valid1 == 1'b1)) {

                // ------------------------------------------------
                // Contention: use round-robin
                // ------------------------------------------------

                if *rr1 == 1'b0 {

                    send out1.beat(*packet0) >>

                    {
                        set rr1 := 1'b1;
                        set valid0 := 1'b0
                    } >>

                    if (*packet0)[33] == 1'b0 {

                        {
                            set lock1 := 1'b1;
                            set owner1 := 1'b0
                        }

                    } else {

                        cycle 1
                    }

                } else {

                    send out1.beat(*packet1) >>

                    {
                        set rr1 := 1'b0;
                        set valid1 := 1'b0
                    } >>

                    if (*packet1)[33] == 1'b0 {

                        {
                            set lock1 := 1'b1;
                            set owner1 := 1'b1
                        }

                    } else {

                        cycle 1
                    }
                }
            }

            else if *valid0 == 1'b1 {

                send out1.beat(*packet0) >>
                set valid0 := 1'b0 >>

                if (*packet0)[33] == 1'b0 {

                    {
                        set lock1 := 1'b1;
                        set owner1 := 1'b0
                    }

                } else {

                    cycle 1
                }

            }

            else if *valid1 == 1'b1 {

                send out1.beat(*packet1) >>
                set valid1 := 1'b0 >>

                if (*packet1)[33] == 1'b0 {

                    {
                        set lock1 := 1'b1;
                        set owner1 := 1'b1
                    }

                } else {

                    cycle 1
                }

            }

            else {

                cycle 1
            }
        })
    }
}


// ============================================================
// SOURCE 0
// ============================================================
//
// Generates a two-beat packet:
//
//   Beat 1: data A0000001, dest 0, TLAST 0
//   Beat 2: data A0000002, dest 0, TLAST 1
//
// Then repeats.
//
// ============================================================

proc source0(ep : right stream_ch) {

    reg out_beat : logic[34];

    loop {

        // First beat of packet
        {
            set out_beat[0+:32] := 32'hA0000001;
            set out_beat[32+:1] := [1'b0];
            set out_beat[33+:1] := [1'b0]
        } >>

        send ep.beat(*out_beat) >>

        // Second beat of packet
        {
            set out_beat[0+:32] := 32'hA0000002;
            set out_beat[32+:1] := [1'b0];
            set out_beat[33+:1] := [1'b1]
        } >>

        send ep.beat(*out_beat) >>

        cycle 1
    }
}


// ============================================================
// SOURCE 1
// ============================================================
//
// Generates a two-beat packet:
//
//   Beat 1: data B0000001, dest 0, TLAST 0
//   Beat 2: data B0000002, dest 0, TLAST 1
//
// Both sources target output 0 so that contention and
// round-robin arbitration can be observed.
//
// ============================================================

proc source1(ep : right stream_ch) {

    reg out_beat : logic[34];

    loop {

        // First beat of packet
        {
            set out_beat[0+:32] := 32'hB0000001;
            set out_beat[32+:1] := [1'b0];
            set out_beat[33+:1] := [1'b0]
        } >>

        send ep.beat(*out_beat) >>

        // Second beat of packet
        {
            set out_beat[0+:32] := 32'hB0000002;
            set out_beat[32+:1] := [1'b0];
            set out_beat[33+:1] := [1'b1]
        } >>

        send ep.beat(*out_beat) >>

        cycle 1
    }
}


// ============================================================
// SINK 0
// ============================================================
//
// Receives output 0 traffic.
//
// ============================================================

proc sink0(ep : left stream_ch) {

    loop {

        let b = recv ep.beat >>

        dprint "OUTPUT0 DATA" (b) >>

        cycle 1
    }
}


// ============================================================
// SINK 1
// ============================================================
//
// Receives output 1 traffic.
//
// ============================================================

proc sink1(ep : left stream_ch) {

    loop {

        let b = recv ep.beat >>

        dprint "OUTPUT1 DATA" (b) >>

        cycle 1
    }
}


// ============================================================
// TOP
// ============================================================
//
// Creates all channels and connects:
//
//   source0 -> input0_router
//   source1 -> input1_router
//
//   input0_router -> output0_arbiter
//   input0_router -> output1_arbiter
//
//   input1_router -> output0_arbiter
//   input1_router -> output1_arbiter
//
//   output0_arbiter -> sink0
//   output1_arbiter -> sink1
//
// ============================================================

proc Top() {

    // --------------------------------------------------------
    // External input channels
    // --------------------------------------------------------

    chan in0_left -- in0_right : stream_ch;
    chan in1_left -- in1_right : stream_ch;

    // --------------------------------------------------------
    // Internal route channels
    // --------------------------------------------------------

    chan r00_left -- r00_right : route_ch;
    chan r01_left -- r01_right : route_ch;

    chan r10_left -- r10_right : route_ch;
    chan r11_left -- r11_right : route_ch;

    // --------------------------------------------------------
    // Output channels
    // --------------------------------------------------------

    chan out0_left -- out0_right : stream_ch;
    chan out1_left -- out1_right : stream_ch;

    // --------------------------------------------------------
    // Input routers
    // --------------------------------------------------------

    spawn input0_router(
        in0_left,
        r00_right,
        r01_right
    );

    spawn input1_router(
        in1_left,
        r10_right,
        r11_right
    );

    // --------------------------------------------------------
    // Output arbiters
    // --------------------------------------------------------

    spawn output0_arbiter(
        r00_left,
        r10_left,
        out0_right
    );

    spawn output1_arbiter(
        r01_left,
        r11_left,
        out1_right
    );

    // --------------------------------------------------------
    // Test sources
    // --------------------------------------------------------

    spawn source0(in0_right);
    spawn source1(in1_right);

    // --------------------------------------------------------
    // Test sinks
    // --------------------------------------------------------

    spawn sink0(out0_left);
    spawn sink1(out1_left);

    // --------------------------------------------------------
    // Keep Top alive
    // --------------------------------------------------------

    loop {
        cycle 1
    }
}





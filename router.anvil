// ============================================================
// 2x2 CONCURRENT PACKET ROUTER - ANVIL
// ============================================================
//
// Part C implementation
//
// Packet format:
//
//   [33]     = TLAST
//   [32]     = TDEST
//   [31:0]   = TDATA
//
// Arbitration:
//
//   rr = 0 -> Input 0 has priority
//   rr = 1 -> Input 1 has priority
//
// RR is updated ONLY after a successful TLAST transfer
// when both inputs were contending.
//
// Packet locking:
//
//   A packet whose TLAST = 0 locks the output to its owner.
//   The lock is released only after TLAST transfers.
//
// ============================================================


// ============================================================
// STREAM CHANNEL
// ============================================================

chan stream_ch {
    left beat : (logic[34]@#1)
}


// ============================================================
// INTERNAL ROUTE CHANNEL
// ============================================================

chan route_ch {
    left beat : (logic[34]@#1)
}


// ============================================================
// INPUT 0 ROUTER
// ============================================================
//
// Receives beats from Input 0 and routes them according to TDEST.
//
// TDEST = 0 -> Output 0
// TDEST = 1 -> Output 1
//
// A one-entry buffer keeps the beat stable until it is sent
// to the selected output channel.
// ============================================================

proc input0_router(
    in0     : left stream_ch,
    to_out0 : right route_ch,
    to_out1 : right route_ch
) {

    reg packet0 : logic[34];
    reg dest0   : logic;
    reg valid0  : logic;

    loop {

        // --------------------------------------------------------
        // Receive a new beat if the local buffer is empty
        // --------------------------------------------------------

        if *valid0 == 1'b0 {

            try b = recv in0.beat {

                {
                    set packet0 := b;
                    set dest0 := b[32];
                    set valid0 := 1'b1
                } >>

                cycle 1

            } else {

                cycle 1

            }

        }

        else {

            // ----------------------------------------------------
            // Forward buffered beat
            // ----------------------------------------------------

            if *dest0 == 1'b0 {

                send to_out0.beat(*packet0) >>
                set valid0 := 1'b0 >>
                cycle 1

            }

            else {

                send to_out1.beat(*packet0) >>
                set valid0 := 1'b0 >>
                cycle 1

            }
        }
    }
}


// ============================================================
// INPUT 1 ROUTER
// ============================================================

proc input1_router(
    in1     : left stream_ch,
    to_out0 : right route_ch,
    to_out1 : right route_ch
) {

    reg packet1 : logic[34];
    reg dest1   : logic;
    reg valid1  : logic;

    loop {

        // --------------------------------------------------------
        // Receive a new beat if the local buffer is empty
        // --------------------------------------------------------

        if *valid1 == 1'b0 {

            try b = recv in1.beat {

                {
                    set packet1 := b;
                    set dest1 := b[32];
                    set valid1 := 1'b1
                } >>

                cycle 1

            } else {

                cycle 1

            }

        }

        else {

            // ----------------------------------------------------
            // Forward buffered beat
            // ----------------------------------------------------

            if *dest1 == 1'b0 {

                send to_out0.beat(*packet1) >>
                set valid1 := 1'b0 >>
                cycle 1

            }

            else {

                send to_out1.beat(*packet1) >>
                set valid1 := 1'b0 >>
                cycle 1

            }
        }
    }
}


// ============================================================
// OUTPUT 0 ARBITER
// ============================================================
//
// Input 0 and Input 1 may both request Output 0.
//
// Arbitration:
//
//   both valid:
//       rr0 = 0 -> Input 0 wins
//       rr0 = 1 -> Input 1 wins
//
//   only one valid:
//       that input wins
//
// Packet locking:
//
//   TLAST = 0 -> lock output to current owner
//   TLAST = 1 -> release lock
//
// RR:
//
//   RR changes only after TLAST and only if both inputs
//   were contending for this output.
// ============================================================

proc output0_arbiter(
    from_in0 : left route_ch,
    from_in1 : left route_ch,
    out0     : right stream_ch
) {

    reg packet0 : logic[34];
    reg packet1 : logic[34];

    reg valid0 : logic;
    reg valid1 : logic;

    reg rr0    : logic;
    reg lock0  : logic;
    reg owner0 : logic;

    loop {

        // ========================================================
        // FILL INPUT 0 BUFFER
        // ========================================================

        (if *valid0 == 1'b0 {

            try b0 = recv from_in0.beat {

                {
                    set packet0 := b0;
                    set valid0 := 1'b1
                } >>

                cycle 1

            } else {

                cycle 1

            }

        } else {

            cycle 1

        }) >>

        cycle 1 >>


        // ========================================================
        // FILL INPUT 1 BUFFER
        // ========================================================

        (if *valid1 == 1'b0 {

            try b1 = recv from_in1.beat {

                {
                    set packet1 := b1;
                    set valid1 := 1'b1
                } >>

                cycle 1

            } else {

                cycle 1

            }

        } else {

            cycle 1

        }) >>


        // ========================================================
        // ARBITRATION
        // ========================================================

        (
            if *lock0 == 1'b1 {

                // =================================================
                // PACKET LOCK ACTIVE
                // =================================================

                if *owner0 == 1'b0 {

                    // ------------------------------------------------
                    // Input 0 owns Output 0
                    // ------------------------------------------------

                    if *valid0 == 1'b1 {

                        send out0.beat(*packet0) >>

                        if (*packet0)[33] == 1'b1 {

                            // ----------------------------------------
                            // TLAST transferred.
                            // Release lock.
                            //
                            // If Input 1 was also waiting, Input 1
                            // becomes the next RR priority.
                            // ----------------------------------------

                            if *valid1 == 1'b1 {

                                {
                                    set valid0 := 1'b0;
                                    set lock0 := 1'b0;
                                    set rr0 := 1'b1
                                }

                            } else {

                                {
                                    set valid0 := 1'b0;
                                    set lock0 := 1'b0
                                }
                            }

                        } else {

                            // ----------------------------------------
                            // Packet continues.
                            // Keep lock and RR unchanged.
                            // ----------------------------------------

                            set valid0 := 1'b0

                        }

                    } else {

                        cycle 1

                    }

                } else {

                    // ------------------------------------------------
                    // Input 1 owns Output 0
                    // ------------------------------------------------

                    if *valid1 == 1'b1 {

                        send out0.beat(*packet1) >>

                        if (*packet1)[33] == 1'b1 {

                            // ----------------------------------------
                            // TLAST transferred.
                            // Release lock.
                            //
                            // If Input 0 was also waiting, Input 0
                            // becomes the next RR priority.
                            // ----------------------------------------

                            if *valid0 == 1'b1 {

                                {
                                    set valid1 := 1'b0;
                                    set lock0 := 1'b0;
                                    set rr0 := 1'b0
                                }

                            } else {

                                {
                                    set valid1 := 1'b0;
                                    set lock0 := 1'b0
                                }
                            }

                        } else {

                            // ----------------------------------------
                            // Packet continues.
                            // Keep lock and RR unchanged.
                            // ----------------------------------------

                            set valid1 := 1'b0

                        }

                    } else {

                        cycle 1

                    }
                }
            }

            else {

                // =================================================
                // NO PACKET LOCK
                // =================================================

                if ((*valid0 == 1'b1) & (*valid1 == 1'b1)) {

                    // =================================================
                    // CONTENTION
                    // =================================================

                    if *rr0 == 1'b0 {

                        // ---------------------------------------------
                        // Input 0 wins
                        // ---------------------------------------------

                        send out0.beat(*packet0) >>

                        if (*packet0)[33] == 1'b1 {

                            // -----------------------------------------
                            // TLAST transferred.
                            //
                            // Contention existed, so flip RR.
                            // -----------------------------------------

                            {
                                set valid0 := 1'b0;
                                set rr0 := 1'b1
                            }

                        } else {

                            // -----------------------------------------
                            // Packet continues.
                            // Lock to Input 0.
                            // RR must NOT change yet.
                            // -----------------------------------------

                            {
                                set valid0 := 1'b0;
                                set lock0 := 1'b1;
                                set owner0 := 1'b0
                            }
                        }

                    } else {

                        // ---------------------------------------------
                        // Input 1 wins
                        // ---------------------------------------------

                        send out0.beat(*packet1) >>

                        if (*packet1)[33] == 1'b1 {

                            // -----------------------------------------
                            // TLAST transferred.
                            //
                            // Contention existed, so flip RR.
                            // -----------------------------------------

                            {
                                set valid1 := 1'b0;
                                set rr0 := 1'b0
                            }

                        } else {

                            // -----------------------------------------
                            // Packet continues.
                            // Lock to Input 1.
                            // RR must NOT change yet.
                            // -----------------------------------------

                            {
                                set valid1 := 1'b0;
                                set lock0 := 1'b1;
                                set owner0 := 1'b1
                            }
                        }
                    }
                }

                else if *valid0 == 1'b1 {

                    // =================================================
                    // ONLY INPUT 0
                    // =================================================

                    send out0.beat(*packet0) >>

                    if (*packet0)[33] == 1'b1 {

                        // Single requester.
                        // RR remains unchanged.

                        set valid0 := 1'b0

                    } else {

                        // Packet continues.
                        // Lock to Input 0.

                        {
                            set valid0 := 1'b0;
                            set lock0 := 1'b1;
                            set owner0 := 1'b0
                        }
                    }

                }

                else if *valid1 == 1'b1 {

                    // =================================================
                    // ONLY INPUT 1
                    // =================================================

                    send out0.beat(*packet1) >>

                    if (*packet1)[33] == 1'b1 {

                        // Single requester.
                        // RR remains unchanged.

                        set valid1 := 1'b0

                    } else {

                        // Packet continues.
                        // Lock to Input 1.

                        {
                            set valid1 := 1'b0;
                            set lock0 := 1'b1;
                            set owner0 := 1'b1
                        }
                    }

                }

                else {

                    cycle 1

                }
            }
        )
    }
}


// ============================================================
// OUTPUT 1 ARBITER
// ============================================================
//
// Same behavior as Output 0.
//
// rr1 = 0 -> Input 0 wins contention
// rr1 = 1 -> Input 1 wins contention
//
// RR changes only after TLAST on a contended transfer.
// ============================================================

proc output1_arbiter(
    from_in0 : left route_ch,
    from_in1 : left route_ch,
    out1     : right stream_ch
) {

    reg packet0 : logic[34];
    reg packet1 : logic[34];

    reg valid0 : logic;
    reg valid1 : logic;

    reg rr1    : logic;
    reg lock1  : logic;
    reg owner1 : logic;

    loop {

        // ========================================================
        // FILL INPUT 0 BUFFER
        // ========================================================

        (if *valid0 == 1'b0 {

            try b0 = recv from_in0.beat {

                {
                    set packet0 := b0;
                    set valid0 := 1'b1
                } >>

                cycle 1

            } else {

                cycle 1

            }

        } else {

            cycle 1

        }) >>


        // ========================================================
        // FILL INPUT 1 BUFFER
        // ========================================================

        (if *valid1 == 1'b0 {

            try b1 = recv from_in1.beat {

                {
                    set packet1 := b1;
                    set valid1 := 1'b1
                } >>

                cycle 1

            } else {

                cycle 1

            }

        } else {

            cycle 1

        }) >>


        // ========================================================
        // ARBITRATION
        // ========================================================

        (
            if *lock1 == 1'b1 {

                // =================================================
                // PACKET LOCK ACTIVE
                // =================================================

                if *owner1 == 1'b0 {

                    // ------------------------------------------------
                    // Input 0 owns Output 1
                    // ------------------------------------------------

                    if *valid0 == 1'b1 {

                        send out1.beat(*packet0) >>

                        if (*packet0)[33] == 1'b1 {

                            // TLAST transferred.

                            if *valid1 == 1'b1 {

                                {
                                    set valid0 := 1'b0;
                                    set lock1 := 1'b0;
                                    set rr1 := 1'b1
                                }

                            } else {

                                {
                                    set valid0 := 1'b0;
                                    set lock1 := 1'b0
                                }
                            }

                        } else {

                            // Packet continues.
                            // RR unchanged.

                            set valid0 := 1'b0

                        }

                    } else {

                        cycle 1

                    }

                } else {

                    // ------------------------------------------------
                    // Input 1 owns Output 1
                    // ------------------------------------------------

                    if *valid1 == 1'b1 {

                        send out1.beat(*packet1) >>

                        if (*packet1)[33] == 1'b1 {

                            // TLAST transferred.

                            if *valid0 == 1'b1 {

                                {
                                    set valid1 := 1'b0;
                                    set lock1 := 1'b0;
                                    set rr1 := 1'b0
                                }

                            } else {

                                {
                                    set valid1 := 1'b0;
                                    set lock1 := 1'b0
                                }
                            }

                        } else {

                            // Packet continues.
                            // RR unchanged.

                            set valid1 := 1'b0

                        }

                    } else {

                        cycle 1

                    }
                }
            }

            else {

                // =================================================
                // NO PACKET LOCK
                // =================================================

                if ((*valid0 == 1'b1) & (*valid1 == 1'b1)) {

                    // =================================================
                    // CONTENTION
                    // =================================================

                    if *rr1 == 1'b0 {

                        // Input 0 wins.

                        send out1.beat(*packet0) >>

                        if (*packet0)[33] == 1'b1 {

                            // TLAST + contention -> flip RR.

                            {
                                set valid0 := 1'b0;
                                set rr1 := 1'b1
                            }

                        } else {

                            // Packet continues.
                            // Lock to Input 0.
                            // RR unchanged.

                            {
                                set valid0 := 1'b0;
                                set lock1 := 1'b1;
                                set owner1 := 1'b0
                            }
                        }

                    } else {

                        // Input 1 wins.

                        send out1.beat(*packet1) >>

                        if (*packet1)[33] == 1'b1 {

                            // TLAST + contention -> flip RR.

                            {
                                set valid1 := 1'b0;
                                set rr1 := 1'b0
                            }

                        } else {

                            // Packet continues.
                            // Lock to Input 1.
                            // RR unchanged.

                            {
                                set valid1 := 1'b0;
                                set lock1 := 1'b1;
                                set owner1 := 1'b1
                            }
                        }
                    }
                }

                else if *valid0 == 1'b1 {

                    // =================================================
                    // ONLY INPUT 0
                    // =================================================

                    send out1.beat(*packet0) >>

                    if (*packet0)[33] == 1'b1 {

                        set valid0 := 1'b0

                    } else {

                        {
                            set valid0 := 1'b0;
                            set lock1 := 1'b1;
                            set owner1 := 1'b0
                        }
                    }

                }

                else if *valid1 == 1'b1 {

                    // =================================================
                    // ONLY INPUT 1
                    // =================================================

                    send out1.beat(*packet1) >>

                    if (*packet1)[33] == 1'b1 {

                        set valid1 := 1'b0

                    } else {

                        {
                            set valid1 := 1'b0;
                            set lock1 := 1'b1;
                            set owner1 := 1'b1
                        }
                    }

                }

                else {

                    cycle 1

                }
            }
        )
    }
}


// ============================================================
// TOP LEVEL
// ============================================================

proc Top(
    in0  : left stream_ch,
    in1  : left stream_ch,
    out0 : right stream_ch,
    out1 : right stream_ch
) {

    // ========================================================
    // INTERNAL ROUTING CHANNELS
    // ========================================================

    chan r00_left -- r00_right : route_ch;
    chan r01_left -- r01_right : route_ch;

    chan r10_left -- r10_right : route_ch;
    chan r11_left -- r11_right : route_ch;


    // ========================================================
    // INPUT 0
    // ========================================================

    spawn input0_router(
        in0,
        r00_right,
        r01_right
    );


    // ========================================================
    // INPUT 1
    // ========================================================

    spawn input1_router(
        in1,
        r10_right,
        r11_right
    );


    // ========================================================
    // OUTPUT 0
    // ========================================================

    spawn output0_arbiter(
        r00_left,
        r10_left,
        out0
    );


    // ========================================================
    // OUTPUT 1
    // ========================================================

    spawn output1_arbiter(
        r01_left,
        r11_left,
        out1
    );


    // ========================================================
    // KEEP TOP LEVEL ALIVE
    // ========================================================

    loop {
        cycle 1
    }
}
